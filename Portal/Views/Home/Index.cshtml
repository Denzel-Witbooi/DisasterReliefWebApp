@{
    ViewData["Title"] = "Home Page";
}

<div style="background:#ffc947 !important" class="jumbotron">
    <h1 align="center">Welcome to Disaster Relief</h1>
</div>
<div class="row">
    <div class="col order-5 mb-5" align="center">
        <p>
            The Disaster Alleviation Foundation, is a non‐profit organisation.
            The foundation’s mission is to provide practical aid during disasters.
        </p>
    </div>
</div>

<!-- Cards Section -->
<div class="row">
    <!-- Goods Donated Card -->
    <div class="col-sm-4">
        <div class="card text-dark mb-3" style="background-color:#9c27b0;">
            <div class="card-body">
                <h5 class="card-title">Goods Donated</h5>
                <p class="card-text">Explore the goods donated by our supporters.</p>
                <a href="@Url.Action("GoodsStats", "Home")" class="btn btn-dark">View Now</a>
            </div>
        </div>
    </div>

    <!-- Active Disasters Card -->
    <div class="col-sm-4">
        <div class="card text-dark mb-3" style="background-color:#ffa726;">
            <div class="card-body">
                <h5 class="card-title">Active Disasters</h5>
                <p class="card-text">See the current active disasters we are responding to.</p>
                <a href="@Url.Action("DisasterStats", "Home")" class="btn btn-dark">View Now</a>
            </div>
        </div>
    </div>

    <!-- Funds/Money Donated Card -->
    <div class="col-sm-4">
        <div class="card text-dark mb-3" style="background-color:#9c27b0;">
            <div class="card-body">
                <h5 class="card-title">Available Funds</h5>
                <p class="card-text">Check the funds donated to support our mission.</p>
                <a href="@Url.Action("MonetaryStats", "Home")" class="btn btn-dark">View Now</a>
            </div>
        </div>
    </div>
</div>
