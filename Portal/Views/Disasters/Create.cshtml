@model Portal.Models.Disaster

@{
    ViewData["Title"] = "Create";
}

<div class="jumbotron text-center">
    <h1 class="display-4">Create Disaster</h1>
</div>

<div class="container">
    <h4 class="mb-4 text-center">Disaster Details</h4>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-group mb-3">
                        <label asp-for="StartDate" class="control-label">
                            <i class="bi bi-calendar3"></i> Start Date
                        </label>
                        <input asp-for="StartDate" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="EndDate" class="control-label">
                            <i class="bi bi-calendar3"></i> End Date
                        </label>
                        <input asp-for="EndDate" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Description" class="control-label">
                            <i class="bi bi-file-text"></i> Description
                        </label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Location" class="control-label">
                            <i class="bi bi-geo-alt"></i> Location
                        </label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="AidTypeID" class="control-label">
                            <i class="bi bi-box-seam"></i> Aid Type
                        </label>
                        <select asp-for="AidTypeID" class="form-control" asp-items="ViewBag.AidTypeID"></select>
                    </div>
                    <div class="form-group text-center">
                        <input type="submit" value="Create" class="btn btn-custom-create" />
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="mt-3 text-center">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .jumbotron {
        background: #ffc947 !important;
        padding: 2rem 1rem;
        margin-bottom: 2rem;
        border-radius: .3rem;
    }

    .card {
        background-color: white;
        border-radius: .3rem;
        border: 1px solid #ddd;
    }

    .form-group label {
        font-weight: bold;
        display: flex;
        align-items: center;
    }

        .form-group label i {
            margin-right: 8px;
        }

    .btn-custom-create {
        background-color: #ffc947;
        border-color: #ffc947;
        color: white;
    }

        .btn-custom-create:hover {
            background-color: #ffa726; /* Darker yellow */
            border-color: #ffa726;
            color: white;
        }

    .btn-secondary {
        display: flex;
        align-items: center;
        background-color: #6c757d;
        border-color: #6c757d;
        color: white;
    }

        .btn-secondary i {
            margin-right: 5px;
        }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
            color: white;
        }
</style>

