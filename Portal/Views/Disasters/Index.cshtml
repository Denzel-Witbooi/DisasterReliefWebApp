@model IEnumerable<Portal.Models.Disaster>

@{
    ViewData["Title"] = "Index";
}

<div class="jumbotron text-center">
    <h1 class="display-4">List of Disasters</h1>
</div>

<div class="container">
    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-custom-create" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    </div>

    <table class="table table-modern">
        <thead>
            <tr>
                @* <th><i class="bi bi-hash"></i> @Html.DisplayNameFor(model => model.DisasterID)</th> *@
                <th><i class="bi bi-calendar3"></i> @Html.DisplayNameFor(model => model.StartDate)</th>
                <th><i class="bi bi-calendar3"></i> @Html.DisplayNameFor(model => model.EndDate)</th>
                <th><i class="bi bi-file-text"></i> @Html.DisplayNameFor(model => model.Description)</th>
                <th><i class="bi bi-geo-alt"></i> @Html.DisplayNameFor(model => model.Location)</th>
                <th><i class="bi bi-box-seam"></i> @Html.DisplayNameFor(model => model.AidType)</th>
                <th style="width: 220px;"><i class="bi bi-tools"></i> Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                   @*  <td>@Html.DisplayFor(modelItem => item.DisasterID)</td> *@
                    <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                    <td>@Html.DisplayFor(modelItem => item.Location)</td>
                    <td>@Html.DisplayFor(modelItem => item.AidType.Name)</td>
                    <td class="d-flex justify-content-between">
                        <a class="btn btn-sm btn-info me-1" asp-action="Edit" asp-route-id="@item.DisasterID">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a class="btn btn-sm btn-secondary me-1" asp-action="Details" asp-route-id="@item.DisasterID">
                            <i class="bi bi-info-circle"></i> Details
                        </a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.DisasterID">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .jumbotron {
        background: #ffc947 !important;
        padding: 2rem 1rem;
        margin-bottom: 2rem;
        border-radius: .3rem;
    }

    .card-total {
        background-color: #9c27b0;
        color: white;
        padding: 20px;
        margin: 20px 0;
        border-radius: .3rem;
    }

    .total-amount {
        font-size: 2rem;
        font-weight: bold;
        color: #ffeb3b; /* Yellow */
        background-color: #4a148c; /* Dark Purple */
        padding: 10px;
        border-radius: 5px;
        display: inline-block;
    }

    .table-modern {
        width: 100%;
        margin: 20px 0;
        border-collapse: collapse;
    }

        .table-modern th, .table-modern td {
            padding: 12px 15px;
            border: 1px solid #ddd;
            text-align: left;
        }

        .table-modern th {
            background-color: #f2f2f2;
            font-weight: bold;
        }

        .table-modern tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .table-modern tr:hover {
            background-color: #f1f1f1;
        }

    .btn {
        display: flex;
        align-items: center;
    }

        .btn i {
            margin-right: 5px;
        }

    .btn-custom-create {
        background-color: #ffc947;
        border-color: #ffc947;
        color: white;
    }

        .btn-custom-create:hover {
            background-color: #ffa726; /* Darker yellow */
            border-color: #ffa726;
            color: white;
        }
</style>

